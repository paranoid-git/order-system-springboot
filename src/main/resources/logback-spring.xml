<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── Console (human-readable for local dev) ── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Loki (structured JSON shipped to Loki container) ── -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <!-- Must match the Loki service name in docker-compose.yml -->
            <url>http://localhost:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <!--
                    These become Loki stream labels — keep cardinality LOW.
                    Good: app, env, level.  Bad: userId, requestId (high cardinality).
                -->
                <pattern>app=${spring.application.name},env=local,level=%level</pattern>
            </label>
            <message>
                <!-- JSON payload so Grafana can filter/extract fields -->
                <pattern>
                    {
                        "timestamp": "%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}",
                        "level": "%level",
                        "thread": "%thread",
                        "logger": "%logger{36}",
                        "message": "%message",
                        "traceId": "%X{traceId:-none}",
                        "spanId": "%X{spanId:-none}"
                    }
                </pattern>
            </message>
        </format>
    </appender>

    <!-- Route root logger to both appenders -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

    <!-- Silence noisy Kafka client internals — set to WARN or ERROR -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="kafka" level="WARN"/>

</configuration>
